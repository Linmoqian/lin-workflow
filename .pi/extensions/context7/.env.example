# Context7 API Key（在 https://context7.com/dashboard 获取，形如 ctx7sk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx）
# 留空则为匿名访问，限额约 200 次/小时；配置后约 1000 次/小时
CONTEXT7_API_KEY=

# Context7 接口地址（走自建代理时才需要改）
CONTEXT7_BASE_URL=https://context7.com

# context7_get_docs 的默认 token 预算（500-50000）
CONTEXT7_DEFAULT_TOKENS=5000

# 单次请求超时（毫秒，1000-300000）
CONTEXT7_TIMEOUT_MS=30000
