# MinerU API Token（在 https://mineru.net/apiManage/docs 的「API 管理」页创建，形如 sk-xxxxxxxx）
# 不配置时只能用 v1 Agent 轻量接口（免 Token，但单文件 ≤10MB / ≤20 页 / 不支持批量）
MINERU_API_KEY=

# MinerU 接口地址（走自建代理时才需要改）
MINERU_BASE_URL=https://mineru.net

# 接口选择：auto = 有 Key 走 v4 标准接口、没 Key 走 v1 轻量接口
# standard = 强制 v4 标准接口（≤200MB / ≤200 页 / 单次 ≤50 个文件，需 Token）
# agent    = 强制 v1 轻量接口（免 Token，≤10MB / ≤20 页 / 仅单文件）
MINERU_API=auto

# 默认模型版本：vlm（公式 / 复杂版面更准）| pipeline（更快更省额度）| MinerU-HTML（HTML 输入必须用它，扩展会自动切换）
MINERU_MODEL_VERSION=vlm

# 默认文档语言：ch、ch_server、en、japan、korean、chinese_cht、latin、arabic、cyrillic、devanagari、east_slavic、ta、te、ka
MINERU_LANGUAGE=ch

# 轮询间隔（毫秒，1000-60000）：任务提交后多久查一次进度
MINERU_POLL_INTERVAL_MS=3000

# 最长等待时间（毫秒，10000-3600000）：超过后工具返回任务 ID，可由 mineru_query 续查
MINERU_MAX_WAIT_MS=600000

# 单次 HTTP 请求超时（毫秒，1000-600000），不含等待解析的总时长
MINERU_TIMEOUT_MS=60000

# .env 文件自身的路径覆盖（一般不用填，扩展会先找自己所在目录）
# MINERU_ENV_FILE=C:\Users\you\.pi\agent\extensions\mineru\.env
