# Sciverse API Token（在 https://sciverse.space 获取，形如 sci_xxxxxxxx）
# 未配置时所有 sciverse_* 工具都会失败；也可用同名进程环境变量或官方 CLI 凭据覆盖
SCIVERSE_API_TOKEN=

# 接口地址（走自建代理时才需要改）
SCIVERSE_BASE_URL=https://api.sciverse.space

# sciverse_search_papers 默认每页条数（1-50）
SCIVERSE_PAGE_SIZE=10

# sciverse_read_content 单次请求字节数（1-16384，服务端上限）
SCIVERSE_CONTENT_LIMIT=8192

# sciverse_read_content 单次调用累计字节上限（>= 上面的单次值，<= 49152）
SCIVERSE_MAX_CONTENT_BYTES=8192

# 单次请求超时（毫秒，1000-300000）；quality 语义检索较慢，建议 >= 60000
SCIVERSE_TIMEOUT_MS=60000

# 客户端侧每接口每分钟配额（与服务端 30/min 对齐）
SCIVERSE_RATE_LIMIT_PER_MIN=30

# 配额已满时最多等待多久再发请求（毫秒，0 表示立即报错）
SCIVERSE_MAX_WAIT_MS=20000
